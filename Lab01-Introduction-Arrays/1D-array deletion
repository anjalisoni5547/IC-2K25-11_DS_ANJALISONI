//DELETION OF ELEMENT AT THE BEGINNING

#include <iostream>
#include <vector>
using namespace std;

int main() {  
    vector<int> arr = { 10, 20, 30, 40 };
    int n = arr.size();
  
    cout << "Array before deletion\n";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";

    // Shift all the elements 1 position 
    // starting from second element
    for(int i = 1; i < n; i++)
        arr[i - 1] = arr[i];
   
    // Reduce the array size by 1
    n--;

    cout << "\nArray after deletion\n";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";

    return 0;
}

OUTPUT:
Array before deletion
10 20 30 40 
Array after deletion
20 30 40 


