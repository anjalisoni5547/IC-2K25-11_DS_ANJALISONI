//DELETION OF ELEMENT AT THE Kth POSITION

#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> arr = { 23, 243, 43, 43 };
    int n = arr.size();
	int pos = 4;
  
    cout << "Array before deletion\n";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";
	
  	// Delete the element at the given position
    for(int i = pos; i < n; i++) {
    	arr[i - 1] = arr[i];
    }
  
    if(pos <= n)
		n--;
    cout<<endl;

    cout << "Array after deletion\n";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";

    return 0;
}
OUTPUT:
Array before deletion
23 243 43 43 
Array after deletion
23 243 43 

